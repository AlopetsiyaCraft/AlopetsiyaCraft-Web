# ============================================================
# AlopetsiyaCraft Website — переменные окружения
# Скопируйте в .env и заполните:
#   copy .env.example .env
# ============================================================

# Секрет NextAuth (минимум 32 символа). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Ключ чат-моста. Принимается от мода Minecraft (chatbridge) и Discord-бота
# в заголовке x-api-key на /api/chat/from-server. Должен совпадать с chatApiKey
# в config/chatbridge-common.toml на сервере.
CHAT_API_KEY=

# ============================================================
# База данных: (libsql / Turso)
#
# Локально (файл, данные живут в data/, в git не попадают):
#   DATABASE_URL=file:./data/database.db
#
# Облако, чтобы аккаунты пережили переустановку Windows:
# создайте бесплатную БД на https://turso.tech (вкладка Database,
# ~500 МБ, 9 ГБ трафика), затем:
#
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<токен из turso db tokens create>
#
# Для переноса локальной БД в облако используйте `turso db shell` или
# экспорт/импорт — пароли учтёте при этом отдельно.
# ============================================================
DATABASE_URL=file:./data/database.db
DATABASE_AUTH_TOKEN=