# ============================================================
# AlopetsiyaCraft Website — переменные окружения
# Скопируйте в .env и заполните:
#   copy .env.example .env
# ============================================================

# Секрет NextAuth (минимум 32 символа). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Ключ чат-моста. Принимается от мода Minecraft (chatbridge) и Discord-бота
# в заголовке x-api-key на /api/chat/from-server и /api/stats/from-server.
# Должен совпадать с chatApiKey в config/chatbridge-common.toml на сервере.
CHAT_API_KEY=

# Сессия входа на Minecraft-сервер (мод AlopetsiyaAuth): сколько дней после
# /login на сервере игрок может перезаходить с того же IP без пароля.
# Используется в /api/auth/mc-login и /api/auth/mc-check. По умолчанию 7.
MC_SESSION_TTL_DAYS=7

# ============================================================
# Discord-мост (опционально)
#
# Сайт/MC → Discord: URL вебхука канала (Настройки канала → Интеграции →
# Вебхуки → Создать вебхук). Пусто = вебхук выключен.
#   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
#
# Discord → сайт/сервер: токен бота (https://discord.com/developers/applications)
# и ID канала, который слушает бот (пусто = все каналы серверов).
# Запуск: npm run discord-bot
#   DISCORD_BOT_TOKEN=
#   DISCORD_CHANNEL_ID=
#   WEBSITE_URL=http://127.0.0.1:3000
# ============================================================
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
WEBSITE_URL=http://127.0.0.1:3000

# ============================================================
# База данных: (libsql / Turso)
#
# Локально (файл, данные живут в data/, в git не попадают):
#   DATABASE_URL=file:./data/database.db
#
# Облако, чтобы аккаунты пережили переустановку Windows:
# создайте бесплатную БД на https://turso.tech (вкладка Database,
# ~500 МБ, 9 ГБ трафика), затем:
#
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<токен из turso db tokens create>
#
# Для переноса локальной БД в облако используйте `turso db shell` или
# экспорт/импорт — пароли учтёте при этом отдельно.
# ============================================================
DATABASE_URL=file:./data/database.db
DATABASE_AUTH_TOKEN=