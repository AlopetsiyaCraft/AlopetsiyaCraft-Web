# ─────────────────────────────────────────────────────────────
# Конфигурация AlopetsiyaCraft Website
# Скопируй этот файл в .env и заполни значения:
#   copy .env.example .env
# ─────────────────────────────────────────────────────────────

# Секрет для NextAuth (обязателен). Генерация:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────
# База данных (libsql / Turso)
#
# По умолчанию БД лежит в локальном файле:
#   DATABASE_URL=file:./data/database.db
# Этот файл НЕ хранится в git и исчезнет при переустановке Windows.
#
# Чтобы аккаунты и данные переживали переустановку системы / переезд
# на другую машину — заведи бесплатную облачную базу Turso
# (https://turso.tech, лимит: ~500 баз, 9 ГБ) и укажи её здесь:
#
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<токен из turso db tokens create>
#
# После этого просто запустится сайт — он будет работать с той же
# базой из любой машины, а репозиторий останется чистым.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/database.db
DATABASE_AUTH_TOKEN=